# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA DE TORNEO Y CARNETIZACIÓN
# GUÍA DE VARIABLES DE ENTORNO PARA ALWAYSDATA (MYSQL)
# ==============================================================================

# Puerto del servidor (Alwaysdata lo asigna automáticamente en el entorno)
PORT=3050

# Modo de base de datos ('mysql' para producción en Alwaysdata / 'sqlite' para local)
DB_CLIENT=mysql

# Datos de tu base de datos MySQL en Alwaysdata:
# 1. Ve al panel de Alwaysdata -> 'Bases de datos' -> 'MySQL'
# 2. Tu host es normalmente: mysql-[tu_usuario].alwaysdata.net
DB_HOST=mysql-tuusuario.alwaysdata.net
DB_PORT=3306
DB_USER=tuusuario
DB_PASSWORD=tu_contraseña_de_mysql
DB_NAME=tuusuario_torneo

# Clave de seguridad para JWT y sesiones
JWT_SECRET=torneo_san_antonio_secret_key_2026_xyz
